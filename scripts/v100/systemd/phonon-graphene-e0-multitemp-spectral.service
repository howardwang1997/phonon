[Unit]
Description=Graphene E0 q18/q9 300 and 600 K sparse spectral gates
After=phonon-graphene-e0-full-q6.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/root/phonon
Environment=ROOT=/root/phonon
Environment=HOME=/root
Environment=USER=root
Environment=LOGNAME=root
ExecStart=/usr/bin/bash /root/phonon/scripts/v100/run_graphene_e0_multitemp_spectral_gate.sh
TimeoutStartSec=4h
KillMode=control-group
Restart=on-failure
RestartSec=60s
Nice=5
