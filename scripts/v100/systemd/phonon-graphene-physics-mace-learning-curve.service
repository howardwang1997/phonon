[Unit]
Description=Graphene 300/600 K P4-isolated MACE 240-epoch learning curve
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/phonon
ExecStart=/usr/bin/bash /root/phonon/scripts/v100/run_graphene_physics_temperature_mace_learning_curve.sh
TimeoutStartSec=5h
KillMode=control-group
Nice=5
Restart=on-failure
RestartSec=30s

[Install]
WantedBy=multi-user.target
