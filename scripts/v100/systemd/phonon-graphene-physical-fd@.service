[Unit]
Description=Graphene physical Fermi-Dirac direct-DFPT campaign %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/phonon
Environment=ROOT=/root/phonon
Environment=WORK_BASE=/data/graphene_physical_fd_dfpt
Environment=NP=8
Environment=HOME=/root
Environment=USER=root
Environment=LOGNAME=root
ExecStart=/usr/bin/bash /root/phonon/scripts/v100/run_graphene_physical_fd_dfpt.sh %i
Restart=on-failure
RestartSec=60
Nice=5
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
