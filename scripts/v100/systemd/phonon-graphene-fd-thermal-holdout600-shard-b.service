[Unit]
Description=Graphene fixed 600 K physical-FD force holdout shard B
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/phonon
Environment=ROOT=/root/phonon
Environment=HOME=/root
Environment=USER=root
Environment=LOGNAME=root
Environment=WORK=/data/graphene_fd_thermal_holdout600_shard_B
ExecStart=/usr/bin/bash /root/phonon/scripts/v100/run_graphene_fd_thermal_holdout600_shard.sh B 32,35,39,43,47,51,56
Restart=on-failure
RestartSec=60
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
