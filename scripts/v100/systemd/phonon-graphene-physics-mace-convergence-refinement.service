[Unit]
Description=Graphene 300/600 K development-only MACE batch=2/4 convergence refinement
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/phonon
ExecStart=/usr/bin/bash /root/phonon/scripts/v100/run_graphene_physics_temperature_mace_convergence_refinement.sh
TimeoutStartSec=1h
KillMode=control-group
Nice=5

[Install]
WantedBy=multi-user.target
