[Unit]
Description=Relay graphene physical-FD thermal labels lane %i to RTX 2060
After=network-online.target phonon-graphene-fd-labels@%i.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/phonon
ExecStart=/usr/bin/bash /root/phonon/scripts/v100/run_graphene_fd_label_relay.sh %i
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
