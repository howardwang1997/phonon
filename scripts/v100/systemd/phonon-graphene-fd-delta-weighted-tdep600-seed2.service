[Unit]
Description=Graphene weighted-delta 600 K full-force TDEP seed 2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/phonon
Environment=ROOT=/root/phonon
Environment=HOME=/root
Environment=USER=root
Environment=LOGNAME=root
ExecStart=/usr/bin/bash /root/phonon/scripts/v100/run_graphene_fd_delta_weighted_tdep600_seed2.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
