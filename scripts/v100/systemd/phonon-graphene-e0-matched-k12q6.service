[Unit]
Description=Graphene E0 matched 15A cell k12 q6 EPW and 450K gate
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/phonon
Environment=ROOT=/root/phonon
Environment=WORK=/data/graphene_e0_epw_matched/k12_q6
Environment=NK=12
Environment=NQ=6
Environment=NP=8
Environment=RUN_STATIC_GATE=1
Environment=HOME=/root
Environment=USER=root
Environment=LOGNAME=root
ExecStart=/usr/bin/bash /root/phonon/scripts/v100/run_graphene_e0_epw_matched_cell.sh full
TimeoutStartSec=24h
KillMode=control-group
Nice=5
Restart=on-failure
RestartSec=60s

[Install]
WantedBy=multi-user.target
