[Unit]
Description=Graphene fixed 600 K physical-FD force holdout shard A
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/phonon
Environment=ROOT=/root/phonon
Environment=HOME=/root
Environment=USER=root
Environment=LOGNAME=root
Environment=WORK=/data/graphene_fd_thermal_holdout600
ExecStart=/usr/bin/bash /root/phonon/scripts/v100/run_graphene_fd_thermal_holdout600_shard.sh A 3,7,11,14,18,22,26,30
Restart=on-failure
RestartSec=60
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
