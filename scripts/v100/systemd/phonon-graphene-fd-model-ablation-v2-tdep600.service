[Unit]
Description=Graphene conservative selected-model 600 K three-seed TDEP
After=network-online.target phonon-graphene-fd-model-ablation-v2-600.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/phonon
Environment=ROOT=/root/phonon
Environment=HOME=/root
Environment=USER=root
Environment=LOGNAME=root
ExecStart=/usr/bin/bash /root/phonon/scripts/v100/run_graphene_fd_model_ablation_v2_tdep600.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
