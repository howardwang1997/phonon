[Unit]
Description=Graphene 450 K on-policy DFT force-label shard %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/phonon
Environment=ROOT=/root/phonon
Environment=HOME=/root
Environment=USER=root
Environment=LOGNAME=root
Environment=WORK=/data/graphene_fd_transferability_p4b/shard_%i
ExecStart=/usr/bin/bash /root/phonon/scripts/v100/run_graphene_fd_transferability_p4b_shard.sh %i
Restart=on-failure
RestartSec=60
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
