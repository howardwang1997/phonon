[Unit]
Description=Graphene frozen 450 K P4 shard merge and C1 acceptance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/phonon
ExecStart=/bin/bash %h/phonon/scripts/2060/run_graphene_fd_transferability_p4c.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=30

[Install]
WantedBy=default.target
