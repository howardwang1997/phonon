[Unit]
Description=Graphene physical-FD P2 joint 300/600 K short model
After=network-online.target phonon-graphene-fd-transferability-p1.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/phonon
Environment=ROOT=%h/phonon
ExecStart=/bin/bash %h/phonon/scripts/2060/run_graphene_fd_transferability_p2_joint.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=180

[Install]
WantedBy=default.target
