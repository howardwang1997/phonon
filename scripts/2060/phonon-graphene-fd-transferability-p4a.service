[Unit]
Description=Graphene physical-FD P4a frozen 450 K on-policy sampling
After=network-online.target phonon-graphene-fd-transferability-p2b.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/phonon
Environment=ROOT=%h/phonon
ExecStart=/bin/bash %h/phonon/scripts/2060/run_graphene_fd_transferability_p4a.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=180

[Install]
WantedBy=default.target
