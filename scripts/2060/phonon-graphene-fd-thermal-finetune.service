[Unit]
Description=Graphene physical-FD thermal fine-tune and TDEP queue
After=network-online.target phonon-graphene-v11-control.service

[Service]
Type=simple
WorkingDirectory=%h/phonon
ExecStart=/bin/bash %h/phonon/scripts/2060/run_graphene_fd_thermal_finetune.sh
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
