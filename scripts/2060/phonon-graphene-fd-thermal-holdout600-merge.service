[Unit]
Description=Merge disjoint graphene 600 K physical-FD holdout shards
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/phonon
ExecStart=/bin/bash %h/phonon/scripts/2060/run_graphene_fd_thermal_holdout600_merge.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=180

[Install]
WantedBy=default.target
