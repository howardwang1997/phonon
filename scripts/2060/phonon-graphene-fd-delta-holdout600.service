[Unit]
Description=Graphene 600 K delta-MACE fixed force holdout
After=phonon-graphene-fd-delta-checkpoint-sweep.service

[Service]
Type=simple
WorkingDirectory=%h/phonon
ExecStart=/bin/bash %h/phonon/scripts/2060/run_graphene_fd_delta_holdout600.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=180

[Install]
WantedBy=default.target
