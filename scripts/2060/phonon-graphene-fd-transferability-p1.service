[Unit]
Description=Graphene physical-FD P1 cross-temperature model diagnostic
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/phonon
Environment=ROOT=%h/phonon
ExecStart=/bin/bash %h/phonon/scripts/2060/run_graphene_fd_transferability_p1.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=180

[Install]
WantedBy=default.target
