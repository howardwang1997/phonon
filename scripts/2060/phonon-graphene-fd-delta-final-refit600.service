[Unit]
Description=Graphene 600 K delta final refit after development selection
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/phonon
ExecStart=/bin/bash %h/phonon/scripts/2060/run_graphene_fd_delta_final_refit600.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=180

[Install]
WantedBy=default.target
