[Unit]
Description=Graphene 600 K delta-MACE checkpoint Pareto sweep
After=phonon-graphene-fd-delta-weighted-600.service

[Service]
Type=simple
WorkingDirectory=%h/phonon
ExecStart=/bin/bash %h/phonon/scripts/2060/run_graphene_fd_delta_checkpoint_sweep.sh
Restart=on-failure
RestartSec=60
TimeoutStopSec=180

[Install]
WantedBy=default.target
