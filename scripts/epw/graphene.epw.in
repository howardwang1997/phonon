--
&inputepw
  prefix      = 'graphene'
  outdir      = './tmp'

  elph        = .true.
  epbwrite    = .true.
  epbread     = .false.
  epwwrite    = .true.
  epwread     = .false.

  ! --- Wannierization: graphene pi (pz) bands around E_F (= -1.67 eV) ---
  wannierize  = .true.
  nbndsub     = 2
  num_iter    = 400
  proj(1)     = 'C:pz'
  dis_win_max  = 4.0
  dis_froz_max = 0.0
  ! 2D hexagonal mesh: force the first shell (6 in-plane b-vectors, B1-complete in 2D)
  wdata(1) = 'shell_list = 1'

  ! --- observables: phonon linewidths (Kohn anomaly) + Eliashberg a2F/lambda ---
  phonselfen  = .true.
  a2f         = .true.
  elecselfen  = .false.

  fsthick     = 6.0
  degaussw    = 0.05
  nsmear      = 1
  delta_smear = 0.01

  dvscf_dir   = './save'

  nk1 = 12, nk2 = 12, nk3 = 1
  nq1 = 6,  nq2 = 6,  nq3 = 1

  nkf1 = 60, nkf2 = 60, nkf3 = 1
  nqf1 = 60, nqf2 = 60, nqf3 = 1
/
